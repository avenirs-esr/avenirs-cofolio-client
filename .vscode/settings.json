{
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "never"
  },
  "eslint.format.enable": true,
  "[typescript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[javascript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[json]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[markdown]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "emmet.includeLanguages": {
    "postcss": "css"
  },
  "npm-intellisense.importES6": true,
  "npm-intellisense.importQuotes": "'",
  "npm-intellisense.importLinebreak": "\n",
  "npm-intellisense.importDeclarationType": "const",
  "stylelint.enable": true,
  "stylelint.validate": [
    "css",
    "html",
    "less",
    "markdown",
    "postcss",
    "sass",
    "scss",
    "source.css.styled",
    "source.markdown.math",
    "sugarss",
    "vue",
    "vue-html",
    "vue-postcss",
    "xml",
    "xsl"
  ],
  "css.validate": false,
  "scss.validate": false,
  "[vue]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[css]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "i18n-ally.localesPaths": [
    "apps/avenirs-cofolio-client/src/locales",
    "apps/avenirs-cofolio-client/src/features/student/*/locales",
    "apps/avenirs-cofolio-client/src/features/staff/*/locales"
  ],
  "i18n-ally.enabledFrameworks": ["vue"],
  "i18n-ally.sourceLanguage": "fr",
  "i18n-ally.sortKeys": true,
  "i18n-ally.keystyle": "nested",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "cucumberautocomplete.steps": [
    "apps/avenirs-cofolio-client/e2e/framework/**/*Page.ts",
    "apps/avenirs-cofolio-client/e2e/framework/shared/fixtures/fixtures.ts",
    "apps/avenirs-cofolio-client/e2e/framework/**/*.hook.ts"
  ],
  "cucumberautocomplete.syncfeatures": "apps/avenirs-cofolio-client/e2e/tests/**/*.feature",
  "cucumberautocomplete.strictGherkinCompletion": false
}
