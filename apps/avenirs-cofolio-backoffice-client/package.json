{
  "name": "avenirs-cofolio-backoffice-client",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "build-only": "vite build",
    "build-only:development": "vite build -m development",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:development": "run-p type-check \"build-only:development {@}\" --",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:development": "vite preview -m development",
    "test": "pnpm run test:unit",
    "test:coverage": "vitest run --pool.threads.maxThreads=6 --coverage",
    "test:coverage:shard": "vitest run --reporter=verbose --reporter=blob --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=json --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0",
    "test:unit": "vitest run --pool.threads.maxThreads=6",
    "test:a11y": "run-s -c test:a11y:run test:a11y:cleanup",
    "test:a11y:run": "playwright test --config=a11y/playwright.a11y.config.ts",
    "test:a11y:cleanup": "rimraf a11y/.output",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build --force",
    "prepare": "pnpm run generate:api",
    "generate:api": "orval",
    "postgenerate:api": "eslint ./src/api --fix",
    "generate:feature": "node scripts/generate-feature.mjs"
  },
  "dependencies": {
    "@avenirs-esr/avenirs-dsav": "catalog:",
    "@tanstack/vue-form": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@vue-flow/core": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/router": "catalog:",
    "date-fns": "catalog:",
    "docx": "catalog:backoffice",
    "dompurify": "catalog:backoffice",
    "driver.js": "catalog:",
    "focus-trap": "catalog:",
    "focus-trap-vue": "catalog:",
    "html-to-image": "catalog:",
    "lodash-es": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "vue": "catalog:",
    "vue-advanced-cropper": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:backoffice",
    "@axe-core/playwright": "catalog:backoffice",
    "@playwright/test": "catalog:",
    "@rushstack/eslint-patch": "catalog:",
    "@tsconfig/node26": "catalog:",
    "@types/dompurify": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/coverage-v8": "catalog:backoffice",
    "@vue/runtime-core": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "axe-html-reporter": "catalog:",
    "blob-polyfill": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "jsdom": "catalog:backoffice",
    "madge": "catalog:",
    "msw": "catalog:",
    "npm-run-all2": "catalog:",
    "orval": "catalog:",
    "rimraf": "catalog:",
    "sass-embedded": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:backoffice",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vite-svg-loader": "catalog:",
    "vitest": "catalog:backoffice",
    "vue-component-type-helpers": "catalog:",
    "vue-tsc": "catalog:",
    "workbox-window": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
