{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "node_modules/@avenirs-esr/avenirs-dsav/*": ["./node_modules/@avenirs-esr/avenirs-dsav/*"],
      "node_modules/vitest/*": ["./node_modules/vitest/*"],
      // pnpm uses symlinks; resolve Vue packages locally to keep inferred types portable.
      "@vue/*": ["./node_modules/@vue/*"]
    },
    "types": []
  },
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
