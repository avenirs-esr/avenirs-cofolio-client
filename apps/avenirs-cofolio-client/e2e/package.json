{
  "name": "e2e",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for AVENIR(s) Cofolio Client",
  "scripts": {
    "e2e": "bddgen && playwright test --config=playwright.config.ts",
    "e2e:chrome": "pnpm run e2e --project=chromium --project=mobile-chrome",
    "e2e:chrome:dev": "cross-env VITE_API_URL=https://dev.avenirs-esr.fr/apim pnpm run e2e:chrome",
    "e2e:ui": "pnpm run e2e --project=chromium --project=mobile-chrome --ui",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "e2e:report": "playwright show-report",
    "e2e:desktop": "pnpm run e2e --project=chromium --project=firefox --project=webkit",
    "e2e:desktop:chrome": "pnpm run e2e --project=chromium",
    "e2e:desktop:firefox": "pnpm run e2e --project=firefox",
    "e2e:desktop:safari": "pnpm run e2e --project=webkit",
    "e2e:mobile": "bddgen && playwright test --config=playwright.config.ts --project=mobile-chrome --project=mobile-safari",
    "e2e:mobile:chrome": "pnpm run e2e --project=mobile-chrome",
    "e2e:mobile:safari": "pnpm run e2e --project=mobile-safari",
    "bddgen": "bddgen",
    "lint:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "catalog:e2e",
    "@types/node": "catalog:e2e",
    "cross-env": "catalog:",
    "dotenv": "catalog:",
    "playwright": "catalog:",
    "playwright-bdd": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:e2e",
    "vue-i18n": "catalog:"
  }
}
