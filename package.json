{
  "name": "avenirs-studio-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "build": "pnpm --parallel run build",
    "build-only": "pnpm --parallel --filter './apps/*' run build-only",
    "build:development": "pnpm --parallel --filter './apps/*' run build:development",
    "build-only:development": "pnpm --parallel --filter './apps/*' run build-only:development",
    "clean:dist": "pnpm --dir apps/avenirs-cofolio-client run clean:dist",
    "preview": "pnpm --parallel --filter './apps/*' run preview",
    "preview:development": "pnpm --parallel --filter './apps/*' run preview:development",
    "type-check": "pnpm --parallel --filter './apps/*' run type-check",
    "lint": "pnpm --parallel run lint",
    "format": "pnpm --parallel run format",
    "test": "pnpm --parallel run test",
    "test:unit": "pnpm --parallel run test:unit",
    "test:watch": "pnpm --parallel run test:watch",
    "test:coverage": "pnpm --parallel run test:coverage",
    "test:coverage:shard": "pnpm --parallel run test:coverage:shard",
    "test:a11y": "pnpm --parallel --filter './apps/*' run test:a11y",
    "test:a11y:run": "pnpm --parallel --filter './apps/*' run test:a11y:run",
    "test:a11y:cleanup": "pnpm --parallel --filter './apps/*' run test:a11y:cleanup",
    "test:workspace": "node --test scripts/workspace.test.mjs",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "apps/avenirs-cofolio-client/**": "pnpm --dir apps/avenirs-cofolio-client exec eslint --fix"
  }
}
