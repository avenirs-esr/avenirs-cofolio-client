{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#shared/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}
