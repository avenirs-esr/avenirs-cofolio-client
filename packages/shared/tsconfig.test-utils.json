{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test-utils.tsbuildinfo",
    "paths": {
      "vue-component-type-helpers": ["./node_modules/vue-component-type-helpers"]
    },
    "types": ["node"]
  },
  "include": [
    "test-utils/**/*.ts",
    "src/api/http-status.ts",
    "src/api/generated/types/eErrorCode.ts",
    "src/exceptions/base-api-error-codes.ts",
    "src/exceptions/error-codes.ts",
    "src/ui/**/*.stub.ts",
    "src/types/**/*.ts"],
  "exclude": [
    "test-utils/**/*.test.ts",
    "test-utils/mount-composable.ts",
    "src/**/*.test.ts"
  ]
}
