{
  "name": "@avenirs-esr/test-utils",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./a11y": "./src/a11y/index.ts",
    "./a11y/*": "./src/a11y/*.ts",
    "./unit": "./src/unit/index.ts",
    "./unit/*": "./src/unit/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --pool.threads.maxThreads=6",
    "test:coverage": "vitest run --pool.threads.maxThreads=6 --coverage",
    "type-check": "tsc --build --force"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@vue/test-utils": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@avenirs-esr/avenirs-dsav": "catalog:",
    "@playwright/test": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-component-type-helpers": "catalog:",
    "vue-i18n": "catalog:"
  }
}
